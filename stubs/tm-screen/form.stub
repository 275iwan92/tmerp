<?php

use {{MODEL_FQN}};
use App\Support\Localization\Translator;
use Illuminate\Support\Facades\Auth;
use Livewire\Attributes\Title;
use Livewire\Component;

new #[Title('Form {{TITLE}} — TELASIH MAKMUR ERP')] class extends Component
{
    public ?int $recordId = null;

{{PROPS}}
    public string $formError = '';

    public function mount(?int ${{ROUTE_PARAM}} = null): void
    {
        if (${{ROUTE_PARAM}}) {
            $r = {{MODEL}}::findOrFail(${{ROUTE_PARAM}});
            $this->recordId = $r->{{PK}};
{{MOUNT}}
        }
    }

    public function save(): void
    {
        $this->formError = '';

        $data = $this->validate([
{{RULES}}
        ]);

        $login = Auth::user()->login;

        if ($this->recordId) {
            {{MODEL}}::whereKey($this->recordId)->update($data + ['updated_by' => $login]);
            session()->flash('saved', Translator::t('shared_saved', 'Data tersimpan.'));

            return;
        }

        $r = {{MODEL}}::create($data + ['created_by' => $login, 'updated_by' => $login]);
        $this->redirect(route('{{EDIT_ROUTE}}', ['{{ROUTE_PARAM}}' => $r->{{PK}}]));
    }
};
?>
<div>
    <header class="bg-navy text-white px-5 py-3 flex items-center gap-3.5 sticky top-0 z-50">
        <b class="text-[15px]">{{ $recordId ? Translator::t('shared_edit', 'Edit').' {{TITLE}}' : '{{TITLE}} '.Translator::t('shared_new', 'Baru') }}</b>
        <div class="ml-auto flex items-center gap-2">
            <button type="button" wire:click="save" class="px-4 py-1.5 rounded text-xs font-semibold bg-accent text-white cursor-pointer">{{ Translator::t('shared_btn_save', 'Simpan') }}</button>
            <x-back-button :fallback="route('{{LIST_ROUTE}}')" title="{{ Translator::t('shared_back_to_list', 'Kembali ke Daftar') }}" />
        </div>
    </header>

    <div class="max-w-[900px] mx-auto my-5 px-4">
        <x-alert.banner type="success" :message="session('saved')" />
        <x-alert.banner type="danger" :message="$formError" />

        <div class="bg-white border border-[#d7dbe2] rounded-md p-4 mb-4">
            <h3 class="text-xs text-navy uppercase font-bold mb-3">1. {{ Translator::t('shared_section_identity', 'Identitas') }}</h3>
            <div class="grid two mb-3">
{{FIELDS}}
            </div>
        </div>
    </div>
</div>
