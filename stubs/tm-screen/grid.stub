            <x-grid.table-shell>
                <table class="w-full text-xs border-collapse">
                    <thead>
                        <tr>
                            <th class="px-3 py-2 bg-[#fafbfd] border-b border-[#eef1f5] sticky top-0 z-[1] w-[110px]"></th>
                            <th class="text-left px-3 py-2 bg-[#fafbfd] text-[#667] text-[11px] uppercase tracking-wide border-b border-[#eef1f5] sticky top-0 z-[1]">{{ Translator::t('shared_col_name', 'Nama') }}</th>
                            @foreach ($gridVisibleColumns as $key)
                                <th class="text-left px-3 py-2 bg-[#fafbfd] text-[#667] text-[11px] uppercase tracking-wide border-b border-[#eef1f5] sticky top-0 z-[1] whitespace-nowrap">
                                    <button type="button" wire:click="toggleGridSort('{{ $key }}')" class="inline-flex items-center gap-1 cursor-pointer hover:text-navy {{ $gridSortColumn === $key ? 'text-accent' : '' }}">
                                        {{ $this->gridColumnDefs()[$key]['label'] }}
                                        <span class="text-[9px] {{ $gridSortColumn === $key ? 'text-accent' : 'opacity-40' }}">{{ $gridSortColumn === $key && $gridSortDirection === 'desc' ? '▼' : '▲' }}</span>
                                    </button>
                                </th>
                            @endforeach
                        </tr>
                    </thead>
                    <tbody>
                        @forelse ($this->items as $row)
                            <tr class="border-b border-[#eef1f5] hover:bg-[#fbfcfe] cursor-pointer" wire:key="row-{{ $row->{{PK}} }}" wire:dblclick="openItem({{ $row->{{PK}} }})" title="{{ Translator::t('hrm_emp_dblclick_detail_hint', 'Klik 2x untuk buka detail') }}">
                                <td class="px-3 py-2 whitespace-nowrap">
                                    <div class="flex items-center gap-1.5">
{{ACTION_CELL}}
                                    </div>
                                </td>
                                <x-grid.identity-cell :id="$row->{{PK}}" :name="$row->{{NAME_COL}}" :code="$row->{{CODE_COL}}" />
                                @foreach ($gridVisibleColumns as $key)
                                    <td class="px-3 py-2">{{ $this->columnValue($row, $key) }}</td>
                                @endforeach
                            </tr>
                        @empty
                            <x-grid.empty-row :colspan="count($gridVisibleColumns) + 2" />
                        @endforelse
                    </tbody>
                </table>
            </x-grid.table-shell>

