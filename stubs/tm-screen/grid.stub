                        class="w-56 shrink-0 px-2.5 py-1.5 border border-[#d7dbe2] rounded text-xs">
                </div>
                <x-slot:tools>
                    @include('components.grid.filters-panel')
                    @include('components.grid.toolbar-buttons')
                </x-slot:tools>
