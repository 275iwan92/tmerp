<?php

use App\Livewire\Concerns\HasCustomizableGrid;
use {{MODEL_FQN}};
use App\Support\Localization\Translator;
use Illuminate\Support\Facades\Auth;
use Livewire\Attributes\Computed;
use Livewire\Attributes\Title;
use Livewire\Component;
use Livewire\WithPagination;

new #[Title('{{TITLE}} — TELASIH MAKMUR ERP')] class extends Component
{
    use HasCustomizableGrid;
    use WithPagination;

    protected function gridKey(): string
    {
        return '{{GRID_KEY}}';
    }

    protected function gridColumnDefs(): array
    {
        return [
            // 'kolom' => ['label' => Translator::t('{{T_PREFIX}}_col_kolom', 'Label')],
            'created_by' => ['label' => Translator::t('shared_col_created_by', 'Dibuat Oleh')],
        ];
    }

    protected function gridDefaultColumns(): array
    {
        return ['created_by'];
    }

    protected function gridBaseQuery()
    {
        return {{MODEL}}::query();
    }

    protected function gridIdentitySearchColumns(): array
    {
        return ['{{CODE_COL}}' => Translator::t('shared_col_code', 'Kode'), '{{NAME_COL}}' => Translator::t('shared_col_name', 'Nama')];
    }

    #[Computed]
    public function items()
    {
        return $this->gridSortedQuery()
            ->when(! $this->gridSortColumn, fn ($q) => $q->orderBy('{{NAME_COL}}'))
            ->paginate($this->perPage);
    }

    #[Computed]
    public function stats(): array
    {
        return [
            'total' => {{MODEL}}::count(),
            '{{STAT_KEY}}' => {{MODEL}}::where('{{STAT_COL}}', {{STAT_VAL}})->count(),
        ];
    }

    public function columnValue($row, string $key): string
    {
        return match ($key) {
            default => (string) (data_get($row, $key) ?? '—'),
        };
    }

    public function openItem(int $id)
    {
        return $this->redirect(route('{{OPEN_ROUTE}}', ['{{ROUTE_PARAM}}' => $id]));
    }
{{EXTRA_METHODS}}
};
?>

<div>
    <div class="max-w-[1500px] mx-auto my-5 px-4">

        <x-grid.stat-row :count="2">
            <x-grid.stat-box tone="total" label="{{ Translator::t('{{T_PREFIX}}_stat_total', 'Total') }}" :value="number_format($this->stats['total'])" />
            <x-grid.stat-box tone="{{STAT_TONE}}" label="{{ Translator::t('{{T_PREFIX}}_stat_{{STAT_KEY}}', '{{STAT_LABEL}}') }}" :value="number_format($this->stats['{{STAT_KEY}}'])" />
        </x-grid.stat-row>

        <div class="bg-white border border-[#d7dbe2] rounded-md mb-4 overflow-hidden">
            <x-grid.toolbar>
