APP_NAME=Realtime
APP_ENV=production
APP_KEY=
APP_DEBUG=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb

# Kunci aplikasi WebSocket: harus SAMA dengan CHAT_REALTIME_APP_ID / _KEY / _SECRET di aplikasi pemakai.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Alamat tempat server mendengarkan (0.0.0.0 = semua kartu jaringan, supaya komputer lain di LAN bisa menyambung).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
