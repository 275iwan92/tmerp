rules_version = '2';

// Plan A (recruitment_tier3.md §2) — portal kandidat baca/tulis HANYA dokumen
// miliknya sendiri (uid = auth.uid). Internal (tm2hrr sync worker) pakai Admin
// SDK yang bypass rules ini sepenuhnya, jadi rules ini murni proteksi sisi
// client portal, bukan jalur akses worker.
service cloud.firestore {
  match /databases/{database}/documents {
    match /candidates/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /family_members/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /education/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /work_experience/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /submissions/{submissionUuid} {
      allow create: if request.auth != null && request.resource.data.candidate_uid == request.auth.uid;
      allow read: if request.auth != null && resource.data.candidate_uid == request.auth.uid;
      allow update, delete: if false; // hanya worker internal (Admin SDK) yang boleh ubah sync_status
    }

    match /vacancy_public/{vacancyCode} {
      allow read: if true; // mirror read-only, publik
      allow write: if false; // ditulis worker internal saja
    }
  }
}
